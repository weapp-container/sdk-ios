    "isoDep": "Only valid ISO7816 APDU; OS enforces signed TAG entitlement and configured AID allowlist; raw RF framing not provided",
    "mifareUltralight": "Native sendMiFareCommand only for actual ultralight family, Crypto1 unsupported",
    "nfcF": "Native sendFeliCaCommandPacket max254 bytes excludes LEN/CRC; adapter translates official wire packet including LEN",
    "nfcV": "Native sendRequest flag+command+data total<=256 bytes; adapter rejoins response flag+data",
    "qualification": "Host opt-in/configuration is not proof of signed entitlement; native reader activation/invalidation is authoritative",
    "officialHeaderExcerpts": [
      {
        "header": "NFCMiFareTag.h",
        "quote": "Support MIFARE UltraLight, Plus, and DESFire products. Crypto1 protocol is not supported."
      },
      {
        "header": "NFCTagReaderSession.h",
        "quote": "NFCPollingISO14443 Support both Type A & B modulation. NFCTagTypeISO7816Compatible and NFCTagTypeMiFare tags will be discovered.",
        "implication": "The public tag protocols expose no general ISO14443-3 A/B raw transceive, ATQA or SAK interface."
      },
      {
        "header": "NFCFeliCaTag.h",
        "quote": "Maximum packet length is 254. Data length (LEN) byte and CRC bytes are calculated and inserted automatically."
      },
      {
        "header": "NFCISO15693Tag.h",
        "quote": "The request data frame is concatenation of 8 bits request flag, 8 bits command code, and optional data. Total length of the data frame cannot exceed 256 bytes."
      },
      {
        "header": "NFCISO7816Tag.h",
        "quote": "initWithData: return nil if input data does not contain a valid APDU."
      },
      {
        "headers": [
          "NFCISO7816Tag.h",
          "NFCMiFareTag.h"
        ],
        "observation": "Neither complete public protocol declaration exposes a maximum raw-transceive size or getter. No hardware maximum is fabricated for IsoDep or MifareUltralight."
      }
    ]
  },
